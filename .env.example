# Copy to .env.local for local dev (never commit the real .env.local)

# PostgreSQL connection.
# Local dev: use docker-compose.yml (postgresql://dental:dental@localhost:5432/dental_ops_dev)
# Deployed (Render): use your Neon pooled connection string (has "-pooler"
# in the hostname) — see docs/deployment.md
DATABASE_URL="postgresql://dental:dental@localhost:5432/dental_ops_dev"

# NextAuth
AUTH_SECRET="replace-with-openssl-rand-base64-32"

# Only needed when deployed somewhere other than Vercel (e.g. Render) —
# tells Auth.js to trust the platform's proxy Host header.
# AUTH_TRUST_HOST=true

# Auth0/OIDC — leave unset. Current decision is self-hosted Auth.js, not a
# paid IdP — see docs/adr/0002-auth-provider.md.
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_ISSUER=
